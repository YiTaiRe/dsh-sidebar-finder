{
  "name": "@local/dsh-sidebar-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把侧边栏空间还给工作区，并把文件与消息查找放进工作区标题行：面板收纳、工作区保底高度、就地内联搜索（文件名/全文/会话消息）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sidebar",
    "search",
    "workspace",
    "finder"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
